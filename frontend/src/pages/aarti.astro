---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro';
const title = 'Hanuman Aarti | श्री हनुमान आरती'; const description = 'श्री हनुमान जी की आरती का हिंदी पाठ।';
---
<Layout {title} {description}><Header /><main id="main" class="page prayer"><p class="eyebrow">आरती</p><h1>आरती कीजै हनुमान लला की</h1><p>दुष्ट दलन रघुनाथ कला की॥</p><p>जाके बल से गिरिवर काँपे।<br />रोग दोष जाके निकट न झाँके॥</p><p>अंजनि पुत्र महा बलदाई।<br />संतन के प्रभु सदा सहाई॥</p><p>दे बीरा रघुनाथ पठाए।<br />लंका जारि सिया सुधि लाए॥</p><p class="muted">आरती के अनेक पारंपरिक पाठ-रूप प्रचलित हैं। अपने परिवार या परंपरा में प्रचलित पूर्ण पाठ का अनुसरण करें।</p></main><Footer /></Layout>
