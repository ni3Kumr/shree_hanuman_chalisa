---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro';
const title = 'About | श्री हनुमान चालीसा'; const description = 'सरल, सुगम और सम्मानपूर्ण डिजिटल हनुमान चालीसा पाठ के बारे में।';
---
<Layout {title} {description}><Header /><main id="main" class="page"><p class="eyebrow">परिचय</p><h1>एक शांत डिजिटल पाठ-पुस्तक</h1><p class="lead">यह वेबसाइट श्री हनुमान चालीसा को बिना विज्ञापन, विकर्षण या अनावश्यक सुविधाओं के सहजता से पढ़ने के लिए बनाई गई है।</p><section><h2>हमारा उद्देश्य</h2><p>साफ देवनागरी टाइपोग्राफी, पर्याप्त रिक्त स्थान और सभी स्क्रीन आकारों पर आरामदायक पठन अनुभव देना।</p></section></main><Footer /></Layout>
