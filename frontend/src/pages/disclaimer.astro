---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const title = 'Disclaimer | श्री हनुमान चालीसा';
const description = 'श्री हनुमान चालीसा वेबसाइट के लिए अस्वीकरण।';
---
<Layout {title} {description}>
  <Header />
  <main id="main" class="page">
    <p class="eyebrow">Disclaimer</p>
    <h1>अस्वीकरण</h1>
    <p>यह वेबसाइट श्री हनुमान चालीसा और संबंधित भक्तिमय सामग्री को सहज पठन के लिए प्रस्तुत करती है। यह केवल सामान्य, आध्यात्मिक और शैक्षिक उद्देश्य के लिए है।</p>
    <section><h2>पाठ और सामग्री</h2><p>हम सामग्री को सम्मानपूर्वक और सावधानी से प्रस्तुत करने का प्रयास करते हैं। पाठ-रूप, उच्चारण और परंपराओं में क्षेत्रीय या पारिवारिक भिन्नताएँ हो सकती हैं। अपनी परंपरा के अनुसार पाठ करना उचित है।</p></section>
    <section><h2>बाहरी लिंक</h2><p>यदि भविष्य में इस वेबसाइट पर बाहरी वेबसाइटों के लिंक दिए जाएँ, तो उनकी सामग्री और गोपनीयता नीतियों के लिए हम उत्तरदायी नहीं होंगे।</p></section>
  </main>
  <Footer />
</Layout>
