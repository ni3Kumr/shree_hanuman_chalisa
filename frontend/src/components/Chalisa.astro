---
import { render } from 'astro:content';
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<article id="chalisa" class="reading" aria-labelledby="reading-title">
  <header><p class="eyebrow">❈ पावन पाठ ❈</p><h2 id="reading-title">॥ {entry.data.title} ॥</h2><p>गोस्वामी तुलसीदास रचित</p></header>
  <Content />
</article>
